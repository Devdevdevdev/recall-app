{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "supabase/functions/ingest-cpsc-recalls/**",
    "supabase/functions/ingest-recall-source/**",
    "supabase/functions/ingest-recall-sources/**",
    "supabase/functions/process-recall-matches/**",
    "supabase/functions/run-recall-automation/**",
    "supabase/functions/send-recall-notifications/**",
    "supabase/functions/_shared/push/store.ts"
  ]
}
