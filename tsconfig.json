{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "audits/**",
    "releases/**",
    "scripts/verify-phase-16-24-replay.ts",
    "tests/phase-16-32-worker-invocation-auth.test.ts",
    "tests/phase-16-33-ticket-invocation.test.ts",
    "tests/phase-17-7a-1-check-owned-product.test.ts",
    "tests/phase-17-7a-f4-store.test.ts",
    "supabase/functions/ingest-cpsc-recalls/**",
    "supabase/functions/ingest-recall-source/**",
    "supabase/functions/ingest-recall-sources/**",
    "supabase/functions/process-recall-matches/**",
    "supabase/functions/process-recall-matches-v2-cohort/**",
    "supabase/functions/process-cpsc-page-evidence/**",
    "supabase/functions/run-recall-automation/**",
    "supabase/functions/send-recall-notifications/**",
    "supabase/functions/_shared/push/store.ts",
    "supabase/functions/check-owned-product/**",
    "supabase/functions/process-owned-product-checks/**",
    "supabase/functions/_shared/productCheck/server.ts",
    "supabase/functions/_shared/productCheck/supabaseStore.ts"
  ]
}
