  "closeoutDecisions": {
    "rcn": "RCN-8 (GTIN-8 whose GS1-8 prefix starts with 0 or 2) => automatic product lookup status `not_eligible`: 0 provider calls, 0 global lookup-cache rows; manual name/brand allowed; the scan stays valid, the product can be saved and the GTIN stays available to existing Recall mechanisms. Recall matching and F-4 are unchanged. RCN-12/13 (02, 04, 20-29) is only flagged; no policy decided.",
    "mvpProvider": "Open Food Facts family, API v3, product_type=all.",
    "paidProvider": "NO-GO for now.",
    "upcitemdb": "Benchmark kept; not integrated in 17.3c.",
    "gs1": "Future evaluation / validation source.",
    "webSearch": "Tavily and generic web search: NO-GO for MVP product lookup.",
    "fallback": "Manual name/brand.",
    "groundTruth": "A provider answer is never ground truth. Physical cases stay unscored until confirmed from the packaging; a case with no packaging and no independent manufacturer/distributor source is excluded from scored ground truth."
  },
  "note": "Benchmark dataset for GTIN -> name + brand lookup. Contains no user data: every GTIN is either public (official recall notice, retailer or brand-syndication page) or one of the three physical products scanned during Phase 17.3a device regression. Ground truth never comes from a benchmarked provider. `raw` is the value a scanner would report; `symbology` is the scanner type used to derive matchingGtin / canonicalGtin14 through src/domain/barcode.ts (toScannedBarcode). Scoring rules are in scripts/bench-product-lookup.mjs: `brandAliases` are accent/case/punctuation-normalized brand spellings that count as the same brand; `nameGroups` is a list of groups, each a list of alternatives, and every group must appear (substring, normalized) in the provider name for the name to be ACCEPTABLE. Variant/size correctness is checked by manual review (`manualReviews` below), never by the heuristic alone.",
  "groundTruthKinds": {
    "official_recall_notice": "Product name, brand and GTIN published together by a government recall authority (CPSC/SaferProducts.gov API, Health Canada recalls-rappels.canada.ca, French RappelConso open data). Independent of every benchmarked provider.",
    "retailer_page": "Retailer product page or retailer product specification sheet showing name, brand and the same GTIN.",
    "brand_syndication": "Brand-owner product content syndication page (Salsify) keyed by the GTIN-14.",
    "physical_packaging_pending": "Physical product scanned in Phase 17.3a; the repository records the GTIN but not the product name/brand. Unscored until the user confirms name/brand from the physical packaging.",
    "generated": "Generated barcode, not a product. Used only for local input-normalization checks; never sent to a provider.",
    "physical_unavailable": "Physical product no longer available and no independent manufacturer/distributor source established. Excluded from scored ground truth; nothing is inferred."
  },
