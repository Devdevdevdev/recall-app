{
  "name": "recall",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.22",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "rn-mlkit-ocr": "0.3.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test:parser": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate-product-label-parser.mjs",
    "test:phase-6-1": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate-phase-6-1.mjs",
    "test:cpsc-ingestion": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate-cpsc-ingestion.mjs",
    "test:matching": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/recall-matching.test.mjs tests/recall-matching-benchmark.test.mjs",
    "test:nemotron": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/nebius-client.test.mjs tests/nemotron-matching.test.mjs",
    "benchmark:matching:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types benchmarks/recall-matching/validate.mjs",
    "benchmark:matching": "npm run benchmark:matching:validate && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types benchmarks/recall-matching/run.mjs",
    "benchmark:matching:nebius:preflight": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types benchmarks/recall-matching/nebius-preflight.mjs",
    "benchmark:matching:nemotron:smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types benchmarks/recall-matching/nemotron-smoke.mjs",
    "benchmark:matching:nemotron": "npm run benchmark:matching:validate && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types benchmarks/recall-matching/run-nemotron.mjs",
    "benchmark:phase-9-1:validate:development": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types benchmarks/recall-matching/phase-9-1/validate.mjs development",
    "benchmark:phase-9-1:validate:holdout": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types benchmarks/recall-matching/phase-9-1/validate.mjs holdout",
    "benchmark:phase-9-1:freeze:verify": "node benchmarks/recall-matching/phase-9-1/freezeGuard.mjs",
    "benchmark:phase-9-1:deterministic": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types benchmarks/recall-matching/phase-9-1/run-deterministic-holdout.mjs",
    "benchmark:phase-9-1:hybrid": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types benchmarks/recall-matching/phase-9-1/run-hybrid-holdout.mjs",
    "benchmark:phase-9-1:plan": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types benchmarks/recall-matching/phase-9-1/run-hybrid-holdout.mjs --plan",
    "benchmark:phase-15:build": "node benchmarks/recall-matching/phase-15/build-dataset.mjs",
    "benchmark:phase-15:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types benchmarks/recall-matching/phase-15/validate.mjs",
    "benchmark:phase-15:freeze:verify": "node benchmarks/recall-matching/phase-15/freezeGuard.mjs",
    "benchmark:phase-15:deterministic": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types benchmarks/recall-matching/phase-15/run-deterministic.mjs",
    "benchmark:phase-15:plan": "node benchmarks/recall-matching/phase-15/plan-paid-runs.mjs",
    "benchmark:phase-15:report": "node benchmarks/recall-matching/phase-15/generate-report.mjs",
    "benchmark:phase-15:nemotron:paid": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types benchmarks/recall-matching/phase-15/run-nemotron-paid.mjs --approved",
    "benchmark:phase-15:hybrid:paid": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types benchmarks/recall-matching/phase-15/run-hybrid-paid.mjs --approved",
    "benchmark:phase-15:hybrid:resume": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types benchmarks/recall-matching/phase-15/resume-hybrid-paid.mjs --approved",
    "test:phase-15": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/phase-15-benchmark.test.mjs",
    "test:hybrid-guarded": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/guarded-hybrid.test.mjs",
    "test:phase-9-1-datasets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/phase-9-1-datasets.test.mjs",
    "test:phase-10": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/phase-10-orchestration.test.mjs tests/phase-10-database.test.mjs tests/phase-10-edge-function.test.mjs tests/alerts-read-model.test.mjs",
    "test:phase-11": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/phase-11-push.test.mjs tests/phase-11-database.test.mjs tests/notification-enable.test.mjs",
    "test:phase-12": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/phase-12-automation.test.mjs tests/phase-12-database.test.mjs",
    "test:phase-13": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/phase-13-product-experience.test.mjs tests/phase-13-database.test.mjs",
    "test:phase-14": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/phase-14-product-and-adapters.test.mjs tests/phase-14-database.test.mjs",
    "test:database": "npx supabase test db",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:parser && npm run test:phase-6-1 && npm run test:cpsc-ingestion && npm run test:matching && npm run test:nemotron && npm run test:hybrid-guarded && npm run test:phase-9-1-datasets && npm run test:phase-10 && npm run test:phase-11 && npm run test:phase-12 && npm run test:phase-13 && npm run test:phase-14 && npm run test:phase-15 && npm run benchmark:matching:validate && npm run benchmark:phase-9-1:validate:development && npm run benchmark:phase-9-1:validate:holdout && npm run benchmark:phase-9-1:freeze:verify && npm run benchmark:phase-15:validate && npm run benchmark:phase-15:freeze:verify"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "rn-mlkit-ocr"
        ]
      }
    }
  },
  "private": true
}
